# Copier en .env et ajuster. NE JAMAIS committer .env.
POSTGRES_USER=panoradent
POSTGRES_PASSWORD=panoradent
POSTGRES_DB=panoradent

S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=panoradent

MODEL_VERSION=mock-0.0.0

# Service d'inference en mode reel (sans effet tant qu'aucun poids n'est depose).
# MODEL_STRICT=1 : refuse de demarrer en mock. A activer des qu'un modele est
# branche, sinon des poids illisibles font servir des detections factices.
MODEL_STRICT=0
# Mode historique seulement (fichier unique MODEL_WEIGHTS_PATH) : les versions
# du registre lisent leur taille d entrainement dans leurs propres poids.
MODEL_IMAGE_SIZE=640
MODEL_CONF_THRESHOLD=0.10
DB_PORT=5432   # mettre 5433 si un PostgreSQL local occupe deja 5432

# --- Authentification : adresse e-mail + mot de passe, et compte Google -------
# OBLIGATOIRE hors développement : secret long et aléatoire, par exemple
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Avec APP_ENV=production, le backend refuse de démarrer si JWT_SECRET est la
# valeur par défaut ou fait moins de 32 caractères, sans client Google, sans
# SMTP (COURRIEL_MODE=smtp) ou avec BCRYPT_COUT < 12.
APP_ENV=development
JWT_SECRET=change-me-in-prod

# Client OAuth déclaré dans la console Google Cloud (type « Application Web »).
# Le secret ne vit qu'ici, côté serveur : jamais dans le dépôt ni dans le frontend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URI de redirection autorisée, à déclarer EXACTEMENT dans la console Google
# (une pour le développement, une pour le cabinet).
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/retour
APP_URL=http://localhost:3000
# Restreindre au domaine Google Workspace du cabinet (vide = pas de restriction).
GOOGLE_ALLOWED_DOMAIN=

# Adresse de l'administrateur initial, créé par le jeu de départ avec les deux
# modes de connexion. Tant qu'il n'a pas de mot de passe, un lien de première
# connexion (24 h) s'affiche dans `docker compose logs backend` (hors
# production) ; il peut aussi entrer avec Google si l'adresse est un compte Google.
ADMIN_EMAIL=

# --- Mots de passe --------------------------------------------------------------
# Coût bcrypt : 12 par défaut et minimum en production.
BCRYPT_COUT=12

# --- E-mails (première connexion, mot de passe oublié) ---------------------------
# console : le message et son lien s'affichent dans `docker compose logs backend`
#           (développement) ;
# smtp    : envoi réel, obligatoire en production.
COURRIEL_MODE=console
COURRIEL_EXPEDITEUR=PanoraDent AI <no-reply@panoradent.local>
# Serveur d'envoi (ex. le relais du cabinet, ou smtp.gmail.com avec un mot de
# passe d'application). Le mot de passe ne vit qu'ici, jamais dans le dépôt.
SMTP_HOTE=
SMTP_PORT=587
SMTP_UTILISATEUR=
SMTP_MOT_DE_PASSE=
SMTP_STARTTLS=true

# Optionnel (valeurs par défaut ci-dessous).
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=7
# Origines CORS, au format JSON (utile seulement hors proxy nginx, ex. next dev).
# ALLOWED_ORIGINS=["http://localhost:3000"]
# Tests automatisés uniquement : IDENTITY_PROVIDER=fake (refusé hors APP_ENV=test).
# IDENTITY_PROVIDER=google

# --- Stockage ----------------------------------------------------------------------
# Alerte d'administration au-delà de ce volume (Go) dans le stockage objet.
STOCKAGE_ALERTE_GO=50

# --- Production au cabinet (docker-compose.prod.yml, voir README « HTTPS au cabinet »)
# Nom sous lequel les postes joignent le serveur ; Caddy émet son certificat
# pour ce nom avec son autorité interne. APP_URL, GOOGLE_REDIRECT_URI et
# ALLOWED_ORIGINS doivent alors utiliser https://<ce nom>.
# PANORADENT_HOTE=panoradent.cabinet.lan
# CADDY_HTTP_PORT=80
# CADDY_HTTPS_PORT=443
